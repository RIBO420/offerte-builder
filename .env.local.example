# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx

# Convex (CONVEX_DEPLOYMENT zet `npx convex dev` zelf)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend webhooks (email tracking)
# RESEND_WEBHOOK_SECRET: Svix signing secret uit het Resend-dashboard.
# Bewijst dat een event echt van Resend komt.
RESEND_WEBHOOK_SECRET=whsec_xxxxx

# CONVEX_WEBHOOK_SECRET: zelfbedacht gedeeld geheim tussen de Next.js
# webhookroute en de Convex-mutation `emailLogs.updateFromWebhook`. Die mutation
# is een publiek Convex-endpoint; zonder dit geheim kan iedereen die de
# deployment-URL kent e-mailstatussen (delivered/opened/bounced) vervalsen.
# LET OP: dezelfde waarde moet in TWEE omgevingen staan:
#   - Vercel (of je lokale .env.local) voor de Next.js route
#   - de Convex-omgeving: npx convex env set CONVEX_WEBHOOK_SECRET <waarde>
# Genereer bijv. met: openssl rand -base64 32
CONVEX_WEBHOOK_SECRET=

# Upstash Redis (for distributed rate limiting - optional)
# Get your credentials from https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI-functies klantdossier (gesprekslog + opname)
# LET OP: de Convex-actions lezen deze uit de CONVEX-omgeving, niet uit dit
# bestand. Plak de waardes hier en zet ze door met:
#   npm run env:sync-ai        (dev-deployment)
#   npm run env:sync-ai:prod   (productie)
# ANTHROPIC_API_KEY: console.anthropic.com → API keys (taakherkenning gesprekslog)
# DEEPGRAM_API_KEY:  console.deepgram.com → API keys (transcriptie Nederlands)
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=

# ─── Next.js-omgeving (Vercel + lokaal) ─────────────────────────────────────
# Mollie-betalingen (facturen) en de webhook-handtekening
MOLLIE_API_KEY=
MOLLIE_WEBHOOK_SIGNING_KEY=
# Calendly-afsprakenlink en webhook-handtekening
NEXT_PUBLIC_CALENDLY_URL=
CALENDLY_WEBHOOK_SIGNING_KEY=
# FleetGo-wagenpark (zie docs/fleetgo-api.md)
FLEETGO_API_KEY=
FLEETGO_API_URL=

# ─── Convex-omgeving (npx convex env set NAAM waarde) ───────────────────────
# Deze leest Convex NIET uit dit bestand; staan hier ter documentatie.
# Resend-mail. Zonder EMAIL_VERZENDEN_ACTIEF="true" wordt niets verstuurd
# (mailGuard, fail-closed) — zo blijft dev stil.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
EMAIL_VERZENDEN_ACTIEF=
# Google Places/Distance Matrix (adressen, reistijden)
GOOGLE_MAPS_API_KEY=
# Website-koppeling (configurator-aanvragen van de publieke site)
WEBSITE_WEBHOOK_SECRET=
ALLOWED_ORIGIN=
SITE_URL=

# ─── Alleen lokaal / tests ──────────────────────────────────────────────────
# Playwright-auth-E2E (stuk, zie docs/dev/dev-omgeving.md)
E2E_CLERK_USER_EMAIL=
E2E_CLERK_USER_PASSWORD=
# npm run dev:login (optioneel)
DEV_LOGIN_APP_ORIGIN=
DEV_LOGIN_TTL_MS=
