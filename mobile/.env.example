# Kopieer naar mobile/.env.local (Expo leest EXPO_PUBLIC_* bij het bundelen).
EXPO_PUBLIC_CONVEX_URL=https://your-project.convex.cloud
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
# Basis-URL van de webapp (API-routes, links)
EXPO_PUBLIC_API_URL=http://localhost:3000
# Alleen dev: Dev Login-knop. Start `npm run dev:login -- --mobiel` in offerte-builder/
# (simulator: http://127.0.0.1:4599; echte telefoon: `--mobiel --lan`, LAN-IP gebruiken)
EXPO_PUBLIC_DEV_LOGIN_URL=http://127.0.0.1:4599
