{
  "expo": {
    "name": "Top Tuinen",
    "slug": "toptuinen",
    "scheme": "toptuinen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "nl.toptuinen.medewerkers",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Gebruik Face ID om snel en veilig in te loggen op Top Tuinen",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "nl.toptuinen.medewerkers",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Gebruik Face ID om snel en veilig in te loggen"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Top Tuinen gebruikt de camera om projectfoto's vast te leggen",
          "microphonePermission": "Top Tuinen gebruikt de microfoon voor spraaknotities bij projecten"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Top Tuinen heeft toegang tot je foto's nodig om projectfoto's toe te voegen",
          "cameraPermission": "Top Tuinen gebruikt de camera om projectfoto's vast te leggen"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Top Tuinen gebruikt je locatie om foto's aan het juiste project te koppelen"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Top Tuinen gebruikt de microfoon voor spraaknotities bij projecten"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b353b3f3-5b5a-456d-9176-0cbcc08719c7"
      }
    },
    "owner": "ricardobos"
  }
}
